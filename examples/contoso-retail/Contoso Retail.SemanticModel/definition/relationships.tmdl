relationship factSales_customer
	fromColumn: 'Fact Sales'.'Customer Key'
	toColumn: 'Dim Customer'.'Customer Key'
	crossFilteringBehavior: oneDirection
	isActive: true

relationship factSales_date
	fromColumn: 'Fact Sales'.'Order Date Key'
	toColumn: 'Dim Date'.'Date Key'
	crossFilteringBehavior: oneDirection
	isActive: true

relationship factSales_product
	fromColumn: 'Fact Sales'.'Product Key'
	toColumn: 'Dim Product'.'Product Key'
	crossFilteringBehavior: oneDirection
	isActive: true

relationship factSales_store
	fromColumn: 'Fact Sales'.'Store Key'
	toColumn: 'Dim Store'.'Store Key'
	crossFilteringBehavior: oneDirection
	isActive: true
