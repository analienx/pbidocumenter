expression pScenarioStartDate = #date(2023, 1, 1) meta [IsParameterQuery=true, Type="Date", IsParameterQueryRequired=true]

	annotation PBI_ResultType = Date

expression pScenarioEndDate = #date(2025, 12, 31) meta [IsParameterQuery=true, Type="Date", IsParameterQueryRequired=true]

	annotation PBI_ResultType = Date

expression fnSeasonalityFactor = (month as number) as number => {0.90, 0.94, 1.02, 1.05, 1.08, 1.13, 0.99, 1.01, 1.09, 1.18, 1.30, 1.48}{month - 1}

	annotation PBI_ResultType = Function

expression stgProductEconomics = #table(type table [#"Product Key" = Int64.Type, #"Unit Price" = Currency.Type, #"Cost Rate" = number], {{1, 1180, 0.66}, {2, 980, 0.68}, {3, 760, 0.63}, {4, 640, 0.70}, {5, 220, 0.57}, {6, 280, 0.61}, {7, 190, 0.72}, {8, 150, 0.60}})

	annotation PBI_ResultType = Table

expression stgSalesPlan = #table(type table [Year = Int64.Type, #"Growth Rate" = number], {{2023, 1.00}, {2024, 1.10}, {2025, 1.21}})

	annotation PBI_ResultType = Table

