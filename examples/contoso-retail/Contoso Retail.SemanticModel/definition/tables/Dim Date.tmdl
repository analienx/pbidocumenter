table 'Dim Date'

	dataCategory: Time

	column 'Date Key'
		dataType: int64
		isKey
		summarizeBy: none

	column Date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none

	column Year
		dataType: int64
		summarizeBy: none

	column Quarter
		dataType: string
		summarizeBy: none

	column 'Month Number'
		dataType: int64
		summarizeBy: none

	column 'Month Name'
		dataType: string
		summarizeBy: none
		sortByColumn: 'Month Number'
