/// Promotion dimension used to analyse campaign mix and return behaviour.
table 'Dim Promotion'
	lineageTag: f3aa9b3b-dade-42bd-b176-1698c8056f6c

	column 'Promotion Key'
		dataType: int64
		isHidden
		isKey
		lineageTag: 6b81cff7-6b1c-4c40-9056-351c52c594a5
		summarizeBy: none
		sourceColumn: Promotion Key

	column 'Promotion Name'
