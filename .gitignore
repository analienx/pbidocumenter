# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Build artifacts
build/
dist/
*.egg-info/
*.spec
!pbip_documenter.spec

# Local/environment-specific config and secrets
.env
.env.*
*.settings.json
settings*.json

# Runtime caches (keep the pbip_documenter.cache source package tracked)
/cache/
/.cache/

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.tmp

# Data and export directories — ignore all content but preserve empty folder structure
Reports/*
!Reports/.gitkeep
Exported Documents/*
!Exported Documents/.gitkeep

# Generated artifacts
*.lnk
matches.json
matching_analysis_results.json

# Debug / personal scripts & helpers (keep only published helpers)
analyze_matching_data.py
check_blanks.py
